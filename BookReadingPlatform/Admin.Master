<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="BookReadingPlatform.Admin" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Admin Panel - Book Reading</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; background-color: #f8fafc; display: flex; }
        
        /* Dark Sidebar */
        .admin-sidebar {
            width: 260px;
            height: 100vh;
            background-color: #0f172a; /* Deep navy blue */
            position: fixed;
            display: flex;
            flex-direction: column;
            color: #94a3b8;
        }
        
        /* Logo Section */
        .logo-container { padding: 30px 24px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); margin-bottom: 15px; }
        .logo-icon {
            background: #3b82f6;
            color: white;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .logo-icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
        .logo-text { display: flex; flex-direction: column; }
        .logo-text strong { font-size: 15px; color: #f8fafc; letter-spacing: 0.2px; }
        .logo-text span { font-size: 11px; color: #94a3b8; }
        
        /* Navigation */
        .nav-menu { display: flex; flex-direction: column; padding: 0 16px; gap: 4px; }
        .nav-link {
            padding: 12px 16px;
            text-decoration: none;
            color: #94a3b8;
            font-size: 14px;
            font-weight: 500;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s;
            position: relative;
        }
        .nav-link:hover { background-color: rgba(255,255,255,0.05); color: #f8fafc; }
        
        /* Active State with Blue Dot */
        .nav-link.active { background-color: #1e293b; color: #f8fafc; }
        .nav-link.active::after {
            content: '';
            position: absolute;
            right: 16px;
            width: 6px;
            height: 6px;
            background-color: #3b82f6;
            border-radius: 50%;
        }
        
        .nav-icon { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; opacity: 0.8; }
        .nav-link.active .nav-icon { color: #3b82f6; opacity: 1; }

        /* Logout Bottom */
        .sidebar-bottom { margin-top: auto; padding: 24px; }
        .btn-logout {
            background-color: transparent;
            color: #ef4444;
            text-decoration: none;
            padding: 12px;
            border-radius: 8px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid rgba(239, 68, 68, 0.3);
            transition: all 0.2s;
        }
        .btn-logout:hover { background-color: rgba(239, 68, 68, 0.1); border-color: #ef4444; }
        .btn-logout svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

        /* Main Content */
        .main-content { margin-left: 260px; padding: 40px; width: calc(100% - 260px); box-sizing: border-box; }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" style="display: flex; width: 100%;">
        
        <!-- Dark Admin Sidebar -->
        <div class="admin-sidebar">
            <div class="logo-container">
                <div class="logo-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <div class="logo-text">
                    <strong>Admin Panel</strong>
                    <span>Book Reading</span>
                </div>
            </div>
            
            <div class="nav-menu">
                <a href="AdminDashboard.aspx" class="nav-link active">
                    <svg class="nav-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg> 
                    Dashboard
                </a>
             <a href="AdminUsers.aspx" class="nav-link">
    <svg class="nav-icon" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg> 
    Users
</a>
                <a href="AdminBooks.aspx" class="nav-link">
    <svg class="nav-icon" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg> 
    Books
</a>
               <a href="AdminCategories.aspx" class="nav-link">
    <svg class="nav-icon" viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg> 
    Categories
</a>
               <a href="AdminReports.aspx" class="nav-link">
    <svg class="nav-icon" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg> 
    Reports
</a>
                <a href="AdminSettings.aspx" class="nav-link">
    <svg class="nav-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06-.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1 z"></path></svg> 
    Settings
</a>
            </div>
            
            <div class="sidebar-bottom">
                <a href="Login.aspx" class="btn-logout">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg> 
                    Logout
                </a>
            </div>
        </div>

        <!-- MAIN CONTENT AREA -->
        <div class="main-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
        
    </form>
</body>
</html>